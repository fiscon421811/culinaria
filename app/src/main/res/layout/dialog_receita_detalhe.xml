<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary"
            android:padding="14dp">

        <TextView
                android:id="@+id/tv_dialog_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="Título da Receita"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

            <TextView
                    android:id="@+id/tv_dialog_cod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cód. 001"
                    android:textColor="#FFCC80"
                    android:textSize="11sp"
                    android:layout_marginEnd="10dp"/>

            <TextView
                    android:id="@+id/tv_dialog_cat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categoria"
                    android:textColor="#FFCC80"
                    android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_compartilhar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Compartilhar"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/primary_light"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_imprimir"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🖨️ Imprimir"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/primary"/>
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_fechar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Fechar"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_link"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🔗 Video"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp">
        <TextView
                android:id="@+id/tv_dialog_receita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:text="Texto da receita aqui..."/>
    </ScrollView>

</LinearLayout>
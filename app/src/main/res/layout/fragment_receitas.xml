<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:padding="12dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍽️ Livro de Receitas"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_premium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="⭐ Premium"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_imprimir_lista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖨️ Imprimir"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/primary"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar por título"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_mic"
            app:endIconContentDescription="Buscar por voz"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionSearch"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_ingrediente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Buscar por ingrediente"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_mic"
            app:endIconContentDescription="Buscar por voz"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_ingrediente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionSearch"/>
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <com.google.android.material.chip.Chip
                    android:id="@+id/btn_todas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/btn_categoria1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doces (1)"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.Chip.Action"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/btn_categoria2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salgados (2)"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.Chip.Action"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/btn_categoria3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outros (3)"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.Chip.Action"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/btn_categoria4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bebidas (4)"
                    style="@style/Widget.MaterialComponents.Chip.Action"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
            android:id="@+id/tv_contagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="0 receita(s)"/>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_receitas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

</LinearLayout>